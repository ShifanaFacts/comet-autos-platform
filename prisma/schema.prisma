// Foundation only: datasource + generator configuration.
// V1 core domain models are NOT defined yet (see docs/03-domain and docs/05-database
// once approved by the solution architect). Do not add models here without approval.

generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
