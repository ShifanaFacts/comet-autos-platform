{
  "name": "comet-autos-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Comet Autos Workshop Management System (internal, single Next.js application)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\" --ignore-path .gitignore",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:start": "node scripts/dev-db.mjs start",
    "db:stop": "node scripts/dev-db.mjs stop",
    "db:seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "unrs-resolver@1.12.2": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "esbuild@0.28.2": true
  }
}
