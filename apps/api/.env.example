# Copy this file to .env and fill in real values. Never commit .env.

# Server
NODE_ENV=development
PORT=3001

# PostgreSQL connection string used by Prisma Client at runtime.
# For local development, run `npm run db:start` from the repo root (starts a
# local embedded PostgreSQL on port 5432 with this database already created).
DATABASE_URL="postgresql://user:password@localhost:5432/comet_autos_dev?schema=public"

# Origin of the Next.js web app, used to configure CORS.
WEB_APP_URL="http://localhost:3000"
